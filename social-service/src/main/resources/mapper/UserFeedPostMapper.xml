<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.food.campusfood.mapper.UserFeedPostMapper">

    <sql id="Base_Column_List">
        id, user_id, content, food_id, image_urls, created_at
    </sql>

    <insert id="insert" parameterType="com.campus.food.campusfood.entity.UserFeedPost"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO user_feed_post (user_id, content, food_id, image_urls)
        VALUES (#{userId}, #{content}, #{foodId}, #{imageUrls})
    </insert>

    <update id="update" parameterType="com.campus.food.campusfood.entity.UserFeedPost">
        UPDATE user_feed_post
        <set>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="content != null">content = #{content},</if>
            <if test="foodId != null">food_id = #{foodId},</if>
            <if test="imageUrls != null">image_urls = #{imageUrls},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="java.lang.Long">
        DELETE FROM user_feed_post
        WHERE id = #{id}
    </delete>

    <select id="selectById" parameterType="java.lang.Long"
            resultType="com.campus.food.campusfood.entity.UserFeedPost">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user_feed_post
        WHERE id = #{id}
    </select>

    <select id="selectByUserId" parameterType="java.lang.Long"
            resultType="com.campus.food.campusfood.entity.UserFeedPost">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user_feed_post
        WHERE user_id = #{userId}
        ORDER BY created_at DESC, id DESC
    </select>

    <select id="selectAll" resultType="com.campus.food.campusfood.entity.UserFeedPost">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user_feed_post
        ORDER BY created_at DESC, id DESC
    </select>

    <select id="selectByIds" parameterType="java.util.List"
            resultType="com.campus.food.campusfood.entity.UserFeedPost">
        SELECT
        <include refid="Base_Column_List"/>
        FROM user_feed_post
        WHERE id IN
        <foreach collection="ids" item="id" separator="," open="(" close=")">
            #{id}
        </foreach>
    </select>
    
</mapper>
