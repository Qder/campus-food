<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.food.campusfood.mapper.FriendRequestMapper">

    <sql id="Base_Column_List">
        id, from_user_id, to_user_id, message, status, created_at, handled_at
    </sql>

    <insert id="insert" parameterType="com.campus.food.campusfood.entity.FriendRequest"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO friend_request (from_user_id, to_user_id, message, status)
        VALUES (#{fromUserId}, #{toUserId}, #{message}, #{status})
    </insert>

    <update id="update" parameterType="com.campus.food.campusfood.entity.FriendRequest">
        UPDATE friend_request
        <set>
            <if test="fromUserId != null">from_user_id = #{fromUserId},</if>
            <if test="toUserId != null">to_user_id = #{toUserId},</if>
            <if test="message != null">message = #{message},</if>
            status = #{status},
            <if test="handledAt != null">handled_at = #{handledAt},</if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="delete" parameterType="java.lang.Long">
        DELETE FROM friend_request
        WHERE id = #{id}
    </delete>

    <select id="selectById" parameterType="java.lang.Long"
            resultType="com.campus.food.campusfood.entity.FriendRequest">
        SELECT
        <include refid="Base_Column_List"/>
        FROM friend_request
        WHERE id = #{id}
    </select>

    <select id="selectByUserId" parameterType="java.lang.Long"
            resultType="com.campus.food.campusfood.entity.FriendRequest">
        SELECT
        <include refid="Base_Column_List"/>
        FROM friend_request
        WHERE from_user_id = #{userId}
           OR to_user_id = #{userId}
    </select>

    <select id="selectAll" resultType="com.campus.food.campusfood.entity.FriendRequest">
        SELECT
        <include refid="Base_Column_List"/>
        FROM friend_request
    </select>

    <select id="selectPending" parameterType="java.util.Map" resultType="int">
        SELECT COUNT(*)
        FROM friend_request 
        WHERE from_user_id = #{fromUserId} AND to_user_id = #{toUserId} AND status=0
    </select>

    <select id="selectInbox" parameterType="java.util.Map" resultType="com.campus.food.campusfood.entity.FriendRequest">
        SELECT
        <include refid="Base_Column_List"/>
        FROM friend_request
        WHERE to_user_id = #{toUserId} AND status = 0
    </select>
</mapper>
