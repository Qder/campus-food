<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.food.campusfood.mapper.ChatGroupMemberMapper">

    <insert id="insert" parameterType="com.campus.food.campusfood.entity.ChatGroupMember"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO chat_group_member (group_id, user_id, role, nickname_in_group)
        VALUES (#{groupId}, #{userId}, #{role}, #{nicknameInGroup})
    </insert>

</mapper>
