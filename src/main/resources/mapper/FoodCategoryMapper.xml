<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.food.campusfood.mapper.FoodCategoryMapper">

    <resultMap id="BaseResultMap" type="com.campus.food.campusfood.entity.FoodCategory">
        <id column="id" property="id" />
        <result column="parent_id" property="parentId" />
        <result column="name" property="name" />
        <result column="sort_no" property="sortNo" />
        <result column="status" property="status" />
        <result column="created_at" property="createdAt" />
    </resultMap>

    <sql id="Base_Column_List">
        id, parent_id, name, sort_no, status, created_at
    </sql>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO food_category (id, parent_id, name, sort_no, status, created_at)
        VALUES (#{id}, #{parentId}, #{name}, #{sortNo}, #{status}, #{createdAt})
    </insert>

    <select id="selectById" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM food_category
        WHERE id = #{id}
    </select>

    <select id="selectEnabled" resultMap="BaseResultMap">
        SELECT
        <include refid="Base_Column_List" />
        FROM food_category
        WHERE status = 1
        ORDER BY sort_no ASC, id ASC
    </select>

    <update id="updateById">
        UPDATE food_category
        <set>
            <if test="parentId != null">parent_id = #{parentId},</if>
            <if test="name != null">name = #{name},</if>
            <if test="sortNo != null">sort_no = #{sortNo},</if>
            <if test="status != null">status = #{status},</if>
            <if test="createdAt != null">created_at = #{createdAt},</if>
        </set>
        WHERE id = #{id}
    </update>

</mapper>
