<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.food.campusfood.mapper.AdminMapper">


    <update id="createMerchant"></update>
    <update id="updateMerchantStatus">
        UPDATE merchant
        SET audit_status = #{status}
        WHERE id = #{id}
          AND deleted = 0
    </update>
    <select id="getPendingMerchants" resultType="com.campus.food.campusfood.entity.Merchant"></select>
</mapper>