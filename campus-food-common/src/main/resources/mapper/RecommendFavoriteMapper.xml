<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.food.campusfood.mapper.RecommendFavoriteMapper">

    <select id="selectFoodIdsByUser" resultType="long">
        SELECT target_id
        FROM user_favorite
        WHERE user_id = #{userId}
          AND target_type = 1
    </select>

</mapper>
