<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campus.food.campusfood.mapper.CampaignStatMapper">

    <select id="selectTotalsByCampaignIds" resultType="com.campus.food.campusfood.entity.CampaignStat">
        SELECT campaign_id,
               SUM(participant_cnt) AS participant_cnt,
               SUM(order_cnt)       AS order_cnt,
               SUM(sales_amount)    AS sales_amount
        FROM campaign_stat
        WHERE campaign_id IN
        <foreach collection="campaignIds" item="cid" open="(" separator="," close=")">
            #{cid}
        </foreach>
        GROUP BY campaign_id
    </select>
</mapper>